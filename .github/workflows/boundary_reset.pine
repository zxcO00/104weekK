// ============================================================
// 邊界重塑 Boundary Reset（老余裸K交易法）— Pine Script v5
// 對應 Python 版 src/pattern_detector.py 的五階段狀態機：
//   狀態1 大格局邊界確立 -> 用 ta.pivotlow() 抓樞紐低點
//   狀態2 刺穿假跌破     -> 跌破邊界 1.5%~15%
//   狀態3 強勢收復       -> N根K棒內收盤站回邊界之上
//   狀態4 打擊區回踩     -> 邊界 ×0.99~1.03 的滿足區
//   狀態5 風控與翻亞當   -> 停損守打擊區局部低點、停利1:1等距翻轉
// ============================================================
//@version=5
indicator("邊界重塑 Boundary Reset（老余裸K）", overlay=true, max_lines_count=20, max_boxes_count=20, max_labels_count=30)

// ------------------------------------------------------------
// 參數設定
// ------------------------------------------------------------
pivotLeft         = input.int(3, "樞紐點左側K棒數", minval=1, group="狀態1：大格局邊界")
pivotRight        = input.int(3, "樞紐點右側K棒數", minval=1, group="狀態1：大格局邊界")
allowRisingLevel  = input.bool(true, "允許邊界微幅上揚（新樞紐略高於舊邊界也接受）", group="狀態1：大格局邊界")

minSweepPct       = input.float(1.5, "最小洗盤深度 (%)", minval=0.1, step=0.1, group="狀態2：刺穿假跌破") / 100
maxSweepPct       = input.float(15.0, "最大洗盤深度 (%)", minval=0.1, step=0.5, group="狀態2：刺穿假跌破") / 100

maxBarsToReclaim  = input.int(3, "收復邊界的最大K棒數", minval=1, group="狀態3：強勢收復")

hitZoneLowerMult  = input.float(0.99, "打擊區下緣係數", step=0.005, group="狀態4：打擊區")
hitZoneUpperMult  = input.float(1.03, "打擊區上緣係數", step=0.005, group="狀態4：打擊區")

localLowBufferPct = input.float(1.0, "停損緩衝 (%)（打擊區局部低點外側）", minval=0, step=0.1, group="狀態5：風控") / 100
minRiskPct        = input.float(2.0, "最小風險下限 (%)（打擊區過窄時的安全下限）", minval=0, step=0.1, group="狀態5：風控") / 100
minRR             = input.float(1.05, "最小風報比 R/R", minval=0.1, step=0.05, group="狀態5：風控")

maxPatternBars    = input.int(60, "型態最長存活K棒數（超過未觸發則失效重來）", minval=5, group="型態存活時間")

// ------------------------------------------------------------
// 狀態1：大格局邊界確立（樞紐低點）
// ------------------------------------------------------------
pivLow = ta.pivotlow(low, pivotLeft, pivotRight)
pivLowBar = bar_index - pivotRight   // pivLow 因為要等右側K棒確認，實際對應的K棒往回推 pivotRight 根

var float sLevel     = na   // 目前的動態關鍵邊界
var int   sLevelBar  = na
var float sweepLow   = na
var int   sweepBar   = na
var bool  sweepActive = false
var bool  reclaimed  = false
var float peak2      = na
var int   peak2Bar   = na

// 有新樞紐低點出現時，決定要不要更新邊界：
// - 還沒有邊界 -> 直接採用
// - 新樞紐略高於（或等於）舊邊界 -> 視為邊界微幅上揚，更新並重置型態（allowRisingLevel 開關控制）
// - 新樞紐明顯低於舊邊界 -> 不更新（避免邊界因雜訊亂跳）
if not na(pivLow)
    shouldUpdate = na(sLevel) or (allowRisingLevel and pivLow >= sLevel * 0.98)
    if shouldUpdate
        sLevel := pivLow
        sLevelBar := pivLowBar
        sweepActive := false
        reclaimed := false
        sweepLow := na
        peak2 := na

// ------------------------------------------------------------
// 狀態2：刺穿假跌破（Liquidity Sweep）
// ------------------------------------------------------------
sweepDepthPct = na(sLevel) ? na : (sLevel - low) / sLevel

if not sweepActive and not na(sLevel) and not na(sweepDepthPct) and sweepDepthPct >= minSweepPct and sweepDepthPct <= maxSweepPct
    sweepActive := true
    sweepLow := low
    sweepBar := bar_index
    reclaimed := false
    peak2 := na

// 洗盤期間持續創新低就更新 sweepLow；若跌破幅度超過上限，視為真跌破，型態失效
if sweepActive and not reclaimed
    if low < sweepLow
        sweepLow := low
    trueBreakdownPct = (sLevel - sweepLow) / sLevel
    if trueBreakdownPct > maxSweepPct
        sweepActive := false

// ------------------------------------------------------------
// 狀態3：強勢收復確認（翻亞當條件成立）
// ------------------------------------------------------------
if sweepActive and not reclaimed and close > sLevel
    barsSinceSweep = bar_index - sweepBar
    if barsSinceSweep <= maxBarsToReclaim
        reclaimed := true
        peak2 := high
        peak2Bar := bar_index
    else
        sweepActive := false   // 拖太久才收復，視為低檔盤整過久，型態失效

// 收復後持續追蹤反彈高點
if reclaimed
    if high > peak2
        peak2 := high
        peak2Bar := bar_index

patternHeight = (reclaimed and not na(peak2) and not na(sweepLow)) ? peak2 - sweepLow : na

// 型態存活太久還沒觸發，失效重置（避免舊型態一直殘留）
if sweepActive and not na(sweepBar) and (bar_index - sweepBar) > maxPatternBars
    sweepActive := false
    reclaimed := false

// ------------------------------------------------------------
// 狀態4：打擊區（滿足區）回踩
// ------------------------------------------------------------
hitZoneTop    = na(sLevel) ? na : sLevel * hitZoneUpperMult
hitZoneBottom = na(sLevel) ? na : sLevel * hitZoneLowerMult

hitZoneTouch = reclaimed and not na(sLevel) and low <= hitZoneTop and close >= hitZoneBottom

// ------------------------------------------------------------
// 狀態5：風控與翻亞當滿足（打擊區局部低點停損 + 1:1翻轉停利）
// ------------------------------------------------------------
barsSincePeak2 = (reclaimed and not na(peak2Bar)) ? bar_index - peak2Bar + 1 : na
zoneLocalLow   = (not na(barsSincePeak2) and barsSincePeak2 > 0) ? ta.lowest(low, barsSincePeak2) : na

entryPrice     = hitZoneTouch ? math.max(sLevel, low) : na
candidateStop  = (hitZoneTouch and not na(zoneLocalLow)) ? zoneLocalLow * (1 - localLowBufferPct) : na
minStopCeiling = hitZoneTouch ? entryPrice * (1 - minRiskPct) : na
stopLoss       = (not na(candidateStop) and not na(minStopCeiling)) ? math.min(candidateStop, minStopCeiling) : na
zoneTooTight   = (not na(candidateStop) and not na(minStopCeiling)) ? candidateStop > minStopCeiling : false

tpAdam = (hitZoneTouch and not na(patternHeight)) ? entryPrice + patternHeight : na

riskAmt   = (not na(entryPrice) and not na(stopLoss)) ? entryPrice - stopLoss : na
rewardAmt = (not na(tpAdam) and not na(entryPrice)) ? tpAdam - entryPrice : na
rrRatio   = (not na(riskAmt) and riskAmt > 0 and not na(rewardAmt)) ? rewardAmt / riskAmt : na

validSignal = hitZoneTouch and not na(rrRatio) and rrRatio >= minRR

// ------------------------------------------------------------
// 繪圖：動態邊界（黃線，持續顯示）
// ------------------------------------------------------------
plot(sLevel, title="動態邊界 S_level", color=color.new(color.yellow, 0), linewidth=2)

// ------------------------------------------------------------
// 繪圖：打擊區（黃框）— 只在收復期間顯示，包覆從反彈高點到目前的範圍
// ------------------------------------------------------------
var box hitZoneBox = na
if reclaimed and not na(hitZoneTop) and not na(hitZoneBottom)
    if na(hitZoneBox)
        hitZoneBox := box.new(left=peak2Bar, top=hitZoneTop, right=bar_index, bottom=hitZoneBottom,
             border_color=color.new(color.yellow, 40), bgcolor=color.new(color.yellow, 85), border_width=1)
    else
        box.set_right(hitZoneBox, bar_index)
        box.set_top(hitZoneBox, hitZoneTop)
        box.set_bottom(hitZoneBox, hitZoneBottom)
        box.set_left(hitZoneBox, peak2Bar)
else
    if not na(hitZoneBox)
        box.delete(hitZoneBox)
        hitZoneBox := na

// ------------------------------------------------------------
// 繪圖：觸發當下的停損線／停利線（只在有效訊號的那根K棒畫出水平延伸線）
// ------------------------------------------------------------
var line slLine = na
var line tpLine = na
var label slLabel = na
var label tpLabel = na

if validSignal
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(slLabel)
        label.delete(slLabel)
    if not na(tpLabel)
        label.delete(tpLabel)

    slLine := line.new(bar_index, stopLoss, bar_index + 20, stopLoss, color=color.new(color.red, 0), width=2, style=line.style_dashed)
    tpLine := line.new(bar_index, tpAdam, bar_index + 20, tpAdam, color=color.new(color.lime, 0), width=2)
    slLabel := label.new(bar_index, stopLoss, text="防守停損 " + str.tostring(stopLoss, format.mintick),
         style=label.style_label_up, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    tpLabel := label.new(bar_index, tpAdam, text="翻亞當停利 " + str.tostring(tpAdam, format.mintick),
         style=label.style_label_down, color=color.new(color.lime, 0), textcolor=color.black, size=size.small)

// 進場箭頭標記
plotshape(validSignal, title="打擊區觸發", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.aqua, 0), size=size.small)

// ------------------------------------------------------------
// 警報
// ------------------------------------------------------------
alertcondition(validSignal, title="邊界重塑：打擊區觸發", message="{{ticker}} 週K回踩打擊區，符合邊界重塑進場條件")

// zoneTooTight 額外提醒（打擊區過窄，停損已套用風險下限）
alertcondition(validSignal and zoneTooTight, title="邊界重塑：打擊區過窄警示",
     message="{{ticker}} 觸發訊號，但打擊區過窄（反彈高點才發生沒幾根K棒），停損已套用風險下限，請留意型態品質")

// ------------------------------------------------------------
// 資訊看板（右上角，方便核對數值）
// ------------------------------------------------------------
var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "動態邊界", text_color=color.white)
    table.cell(infoTable, 1, 0, na(sLevel) ? "-" : str.tostring(sLevel, format.mintick), text_color=color.yellow)
    table.cell(infoTable, 0, 1, "洗盤低點", text_color=color.white)
    table.cell(infoTable, 1, 1, na(sweepLow) ? "-" : str.tostring(sweepLow, format.mintick), text_color=color.orange)
    table.cell(infoTable, 0, 2, "反彈高點", text_color=color.white)
    table.cell(infoTable, 1, 2, na(peak2) ? "-" : str.tostring(peak2, format.mintick), text_color=color.aqua)
    table.cell(infoTable, 0, 3, "進場價", text_color=color.white)
    table.cell(infoTable, 1, 3, na(entryPrice) ? "-" : str.tostring(entryPrice, format.mintick), text_color=color.white)
    table.cell(infoTable, 0, 4, "停損 / 停利", text_color=color.white)
    table.cell(infoTable, 1, 4, (na(stopLoss) or na(tpAdam)) ? "-" : str.tostring(stopLoss, format.mintick) + " / " + str.tostring(tpAdam, format.mintick), text_color=color.white)
    table.cell(infoTable, 0, 5, "風報比", text_color=color.white)
    table.cell(infoTable, 1, 5, na(rrRatio) ? "-" : str.tostring(rrRatio, "#.##"), text_color=color.white)
